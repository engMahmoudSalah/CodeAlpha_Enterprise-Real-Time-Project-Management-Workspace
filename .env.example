# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# RESEND (Recommended for reliable cloud email delivery)
# 1. Sign up at https://resend.com and generate an API key (starts with "re_")
# 2. Add RESEND_API_KEY in your environment variables
# 3. Optional: RESEND_FROM_EMAIL (Default: "Velocity Workspace <onboarding@resend.dev>")
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMTP Mail Server Credentials (Alternative)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
